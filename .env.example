# Adresse publique de l'unique interface Zabbix.
MONITORING_DOMAIN=monitoring.metio-dev.fr
DOKPLOY_NETWORK=dokploy-network
# Réseau privé du proxy DNS local. À modifier uniquement en cas de conflit avec
# un réseau Docker ou privé déjà présent sur le serveur de déploiement.
MONITORING_DNS_SUBNET=10.253.53.0/24
MONITORING_DNS_ADDRESS=10.253.53.53

# Générer deux secrets différents avant tout déploiement. Ne jamais les committer.
POSTGRES_PASSWORD=change-this-postgres-password
ZABBIX_ADMIN_PASSWORD=Cedar-Quartz-4928!

# Port TCP auquel les agents actifs des serveurs se connectent.
ZABBIX_SERVER_PORT=10051
